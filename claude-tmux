#!/bin/bash -l

SESSION="${1:?Usage: claude-tmux <session-name> [directory]}"
DIR="${2:-$(pwd)}"

# Resolve to absolute path
DIR="$(cd "$DIR" 2>/dev/null && pwd)" || {
  echo "Error: directory '$2' does not exist."
  exit 1
}

CLAUDE_CMD="claude --dangerously-skip-permissions '$DIR'"

if tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux attach -t "$SESSION"
else
  exec tmux new-session -s "$SESSION" -c "$DIR" \; send-keys "$CLAUDE_CMD" Enter
fi
